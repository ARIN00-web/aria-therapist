{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd backend && npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/api/index.js"
    }
  ],
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 60,
      "includeFiles": [
        "backend/node_modules/better-auth/**",
        "backend/node_modules/@better-auth/**",
        "backend/node_modules/better-call/**",
        "backend/node_modules/@xenova/**",
        "backend/node_modules/onnxruntime-node/**"
      ]
    }
  }
}
