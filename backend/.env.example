PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/aria
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_SECRET=replace-with-at-least-32-random-characters

# LLM providers — at least one required
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# better-auth (Google OAuth)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Qdrant vector DB (optional — RAG disabled if unset)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=therapy_knowledge

# Upstash Redis rate limiting (optional — falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
