PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/aria

# Security secrets (must be at least 32 random characters in production)
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_SECRET=replace-with-at-least-32-random-characters

# Better Auth configuration
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5001
FRONTEND_ORIGIN=http://localhost:3000

# OpenRouter LLM inference
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional alternative LLM providers
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Qdrant Cloud vector search (therapy knowledge RAG)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=therapy_knowledge

# Optional Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
